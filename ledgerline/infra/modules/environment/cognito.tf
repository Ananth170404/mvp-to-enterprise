# Step 10 (Chapter 7): sign-in with Amazon Cognito.
#
#   browser ──> Cognito's managed sign-in page (passwords, MFA, recovery)
#      │                │
#      └── back to https://<site>/auth/callback with a code ──> the app swaps it for
#          tokens, verifies the ID token and starts its own session (app/auth.py)
#
# Cognito only answers "who is this?". Which tenant someone belongs to and what
# they may do stay in Ledgerline's own users table: a person must exist there
# (invited) before signing in does anything.
#
# Locally the same app code talks to Keycloak instead (docker-compose.yml): only
# the OIDC_* settings differ.

locals {
  public_base_url = "https://${aws_cloudfront_distribution.app.domain_name}"
}

resource "aws_cognito_user_pool" "main" {
  name = local.name

  # Essentials: managed login pages, MFA, 10,000 free monthly active users.
  user_pool_tier = "ESSENTIALS"

  # People sign in with their email address; nobody signs themselves up.
  username_attributes      = ["email"]
  auto_verified_attributes = ["email"]
  admin_create_user_config {
    allow_admin_create_user_only = true # accounts are created by an admin (invites), never by strangers
  }
  username_configuration {
    case_sensitive = false
  }

  password_policy {
    minimum_length                   = 12
    require_lowercase                = true
    require_uppercase                = true
    require_numbers                  = true
    require_symbols                  = false
    temporary_password_validity_days = 3
  }

  # One-time codes from an authenticator app. OPTIONAL here: each person may
  # turn it on. Production would use "ON" (everyone must), or enforce it
  # through the customer's own identity provider (enterprise SSO).
  mfa_configuration = "OPTIONAL"
  software_token_mfa_configuration {
    enabled = true
  }

  account_recovery_setting {
    recovery_mechanism {
      name     = "verified_email"
      priority = 1
    }
  }

  deletion_protection = var.deletion_protection ? "ACTIVE" : "INACTIVE"
}

# The address of the sign-in pages: https://<prefix>.auth.<region>.amazoncognito.com
resource "random_id" "cognito_domain" {
  byte_length = 3
}

resource "aws_cognito_user_pool_domain" "main" {
  domain                = "${local.name}-${random_id.cognito_domain.hex}" # must be unique across AWS
  user_pool_id          = aws_cognito_user_pool.main.id
  managed_login_version = 2 # the current "managed login" pages (version 1 is the older hosted UI)
}

resource "aws_cognito_user_pool_client" "app" {
  name         = "${local.name}-web"
  user_pool_id = aws_cognito_user_pool.main.id

  # A server-side app with a secret (a "confidential client"), using the
  # authorization code flow; the app also sends PKCE.
  generate_secret                      = true
  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["code"]
  allowed_oauth_scopes                 = ["openid", "email", "profile"]
  supported_identity_providers         = ["COGNITO"]
  callback_urls                        = ["${local.public_base_url}/auth/callback"]
  logout_urls                          = ["${local.public_base_url}/login"]
  explicit_auth_flows                  = ["ALLOW_USER_SRP_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"]

  # "Wrong email or password", never "no such user": don't help anyone find accounts.
  prevent_user_existence_errors = "ENABLED"

  id_token_validity = 60 # minutes; the app keeps its own session after sign-in
  token_validity_units {
    id_token = "minutes"
  }
}

# Managed login (version 2) shows its pages only once a style exists; this uses Cognito's defaults.
resource "aws_cognito_managed_login_branding" "app" {
  user_pool_id                = aws_cognito_user_pool.main.id
  client_id                   = aws_cognito_user_pool_client.app.id
  use_cognito_provided_values = true
}

# The client secret is generated by Cognito, so unlike the passwords in
# secrets.tf it can't be write-only: it's in Terraform state (encrypted in S3,
# Chapter 2) and in this parameter, from where ECS injects it. Rotating it:
# `terraform apply -replace=aws_cognito_user_pool_client.app`, then deploy.
resource "aws_ssm_parameter" "oidc_client_secret" {
  name        = "${local.ssm_prefix}/oidc_client_secret"
  description = "Cognito app client secret (for the token exchange)"
  type        = "SecureString"
  value       = aws_cognito_user_pool_client.app.client_secret
}

locals {
  oidc_environment = [
    { name = "OIDC_DISCOVERY_URL", value = "https://cognito-idp.${var.region}.amazonaws.com/${aws_cognito_user_pool.main.id}/.well-known/openid-configuration" },
    { name = "OIDC_CLIENT_ID", value = aws_cognito_user_pool_client.app.id },
    # Cognito's discovery document doesn't list a logout endpoint.
    { name = "OIDC_LOGOUT_URL", value = "https://${aws_cognito_user_pool_domain.main.domain}.auth.${var.region}.amazoncognito.com/logout" },
    { name = "PUBLIC_BASE_URL", value = local.public_base_url },
  ]
}
