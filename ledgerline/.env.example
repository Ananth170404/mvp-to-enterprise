# Copy to .env and fill in. Never commit .env — it is in .gitignore.

# development | production
APP_ENV=development

# Which LLM provider to use: gemini | fake
#   fake  = no API calls; answers from the synthetic generator's ground truth.
#           Lets you run the whole app with no key and no cost.
LLM_PROVIDER=fake

# Model ID lives in config, never in code. Models get deprecated
# (see guide Chapter 1, "the Gemini 2.5 Flash story").
LLM_MODEL=gemini-3.5-flash-lite

# Free-tier keys: Google may use inputs/outputs to improve its products.
# Use only with synthetic data. Use a paid key for anything real.
GEMINI_API_KEY=

# Dev-only login (pick a seeded user). Refuses to start when APP_ENV=production.
# Replaced by real authentication in Chapter 7.
DEV_LOGIN=true

# Max upload size in megabytes
MAX_UPLOAD_MB=10
