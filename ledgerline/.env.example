# Copy to .env and fill in. Never commit .env: it is in .gitignore, and the
# pre-commit hook and CI both scan for secrets.
#
# docker-compose.yml already sets APP_ENV, database URLs and storage for local
# development. This file holds what you choose and what is secret.

# Which LLM provider to use: gemini | fake
#   fake  = no API calls; answers from the synthetic generator's ground truth.
#           Lets you run the whole app with no key and no cost. Refused in production.
LLM_PROVIDER=fake

# Model ID lives in config, never in code (models get retired, restricted and
# silently redirected; see guide Chapter 1).
LLM_MODEL=gemini-3.5-flash-lite

# Free-tier keys: Google may use inputs and outputs to improve its products.
# Use only with synthetic data. Use a paid key, with a spending cap, for anything real.
GEMINI_API_KEY=

# Dev-only login (pick a seeded user). Refused in production; on staging it
# requires SITE_PASSWORD. Replaced by real authentication in Chapter 7.
DEV_LOGIN=true

# Shared password in front of a deployed non-production environment (HTTP Basic
# auth). Leave empty locally.
SITE_PASSWORD=

# Local database passwords (development only; deployed environments get theirs
# from AWS Secrets Manager).
POSTGRES_PASSWORD=ledgerline-dev
APP_DB_PASSWORD=app-dev-pw

MAX_UPLOAD_MB=10

# ----------------------------------------------------------------------------
# Set by the deploy, not by you (shown so you know they exist):
#   APP_ENV=staging | production
#   DB_HOST, DB_NAME        the database (shared)
#   DB_USER, DB_PASSWORD    app user (ledgerline_app), read/write rows only
#   MIGRATION_DB_USER, MIGRATION_DB_PASSWORD
#                           schema owner, used only by the migration step
#   (or full DATABASE_URL / MIGRATION_DATABASE_URL instead of the parts)
#   STORAGE_BACKEND=s3, S3_BUCKET, AWS_REGION
#   GIT_SHA                 baked into the image at build time
